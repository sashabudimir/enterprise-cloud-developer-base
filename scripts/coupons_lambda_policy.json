{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CouponLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/coupons*",
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/coupons*:*"
      ]
    },
    {
      "Sid": "CouponsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/coupons"
    }
  ]
}
